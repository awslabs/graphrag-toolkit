#
# Absence rather than the wrong kind: a datatype property with
# no rdfs:range at all.

@prefix :     <http://example.com/broken#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Company a owl:Class .

:foundedYear a owl:DatatypeProperty ; rdfs:domain :Company .
