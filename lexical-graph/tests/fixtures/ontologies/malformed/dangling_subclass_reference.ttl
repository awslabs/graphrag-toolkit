#
# Rdfs:subClassOf points at :Organization, which is never
# declared an owl:Class - almost always a typo or a missing import.

@prefix :     <http://example.com/broken#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:Company a owl:Class ; rdfs:subClassOf :Organization .
